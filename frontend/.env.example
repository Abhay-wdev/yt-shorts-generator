# Set this in Vercel Dashboard -> Project Settings -> Environment Variables
# If running backend locally during testing, you can use ngrok/localtunnel URL
# If hosting backend on Railway/Render/Fly.io, use the production backend URL
NEXT_PUBLIC_BACKEND_URL=https://your-backend-api.com
NEXT_PUBLIC_API_URL=https://your-backend-api.com/api/v1
